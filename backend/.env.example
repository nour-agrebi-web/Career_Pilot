# Copier ce fichier en .env puis remplacer les valeurs (le .env n'est jamais commité)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=careerpilot
MONGODB_TEST_DB=careerpilot_test
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=remplacer_par_un_secret_long_et_aleatoire
# Clé de chiffrement des CV (laisser vide en dev : dérivée de JWT_SECRET). Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CV_ENCRYPTION_KEY=
# Clé de l'API Claude pour structurer les CV. Vide : analyse locale par règles (sans IA externe).
ANTHROPIC_API_KEY=
# Windows, si Tesseract (OCR des CV scannés) n'est pas dans le PATH :
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
