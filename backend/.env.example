# Copier ce fichier en .env puis remplacer les valeurs (le .env n'est jamais commité)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=careerpilot
MONGODB_TEST_DB=careerpilot_test
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=remplacer_par_un_secret_long_et_aleatoire
# Clé de chiffrement des CV (laisser vide en dev : dérivée de JWT_SECRET). Générer avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CV_ENCRYPTION_KEY=
# IA locale avec Ollama (gratuit, rien ne sort du PC). AI_ENGINE=regles pour désactiver le LLM.
AI_ENGINE=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Qdrant sans Docker : les vecteurs sont dans ce dossier. Plus tard, avec un serveur Qdrant,
# renseigner QDRANT_URL (ex. http://localhost:6333) : QDRANT_PATH est alors ignoré.
QDRANT_PATH=storage/qdrant
QDRANT_URL=
# Windows, si Tesseract (OCR des CV scannés) n'est pas dans le PATH :
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
